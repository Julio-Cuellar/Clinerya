<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.jclinical</groupId>
        <artifactId>clinerya-treatments</artifactId>
        <version>0.10.0-beta.1</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>clinerya-treatments-infra</artifactId>
    <packaging>jar</packaging>

    <name>clinerya-treatments-infra</name>
    <description>Módulo de infraestructura y adaptadores para tratamientos y cotizaciones (Spring Boot, JPA, REST)</description>

    <dependencies>
        <!-- Dependencia del módulo de dominio de tratamientos -->
        <dependency>
            <groupId>com.jclinical</groupId>
            <artifactId>clinerya-treatments-domain</artifactId>
        </dependency>

        <!-- Resolución del usuario autenticado para el control de acceso en los controladores -->
        <dependency>
            <groupId>com.jclinical</groupId>
            <artifactId>clinerya-users-infra</artifactId>
        </dependency>

        <!-- Dependencia del módulo de dominio de pacientes (para validar existencia de pacientes) -->
        <dependency>
            <groupId>com.jclinical</groupId>
            <artifactId>clinerya-patients-domain</artifactId>
        </dependency>

        <!-- CurrentUserResolver: los controladores resuelven aqui al usuario que actua,
             en lugar de aceptarlo desde el body de la peticion. -->
        <dependency>
            <groupId>com.jclinical</groupId>
            <artifactId>clinerya-users-infra</artifactId>
        </dependency>

        <!-- Dependencia del módulo de dominio de inventario (para validar/consultar materiales) -->
        <dependency>
            <groupId>com.jclinical</groupId>
            <artifactId>clinerya-inventory-domain</artifactId>
        </dependency>

        <!-- Dependencia del módulo de dominio de clínicas (para leer el perfil de especialidad) -->
        <dependency>
            <groupId>com.jclinical</groupId>
            <artifactId>clinerya-clinics-domain</artifactId>
        </dependency>

        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Boot Security -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Spring Data JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Lombok y MapStruct -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
