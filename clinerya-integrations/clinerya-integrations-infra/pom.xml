<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.jclinical</groupId>
        <artifactId>clinerya-integrations</artifactId>
        <version>0.10.0-beta.1</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>clinerya-integrations-infra</artifactId>
    <packaging>jar</packaging>

    <name>clinerya-integrations-infra</name>
    <description>Módulo de infraestructura y adaptadores para integraciones externas (Spring Boot, JPA, REST, Rabbit, WebClient)</description>

    <dependencies>
        <!-- Dependencia del módulo de dominio de integraciones -->
        <dependency>
            <groupId>com.jclinical</groupId>
            <artifactId>clinerya-integrations-domain</artifactId>
        </dependency>

        <!-- Dependencia del módulo de dominio de agenda (para consumir ManageAppointmentsUseCase) -->
        <dependency>
            <groupId>com.jclinical</groupId>
            <artifactId>clinerya-agenda-domain</artifactId>
        </dependency>

        <!-- Dependencia del módulo de dominio de pacientes (para enriquecer el evento con el nombre del paciente) -->
        <dependency>
            <groupId>com.jclinical</groupId>
            <artifactId>clinerya-patients-domain</artifactId>
        </dependency>

        <!-- Resolución del usuario autenticado para el control de acceso en los controladores -->
        <dependency>
            <groupId>com.jclinical</groupId>
            <artifactId>clinerya-users-infra</artifactId>
        </dependency>

        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Boot Security -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Spring Boot WebFlux (WebClient, sin necesidad de servidor reactivo) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- Spring Data JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Spring AMQP (RabbitMQ) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
