<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.jclinical</groupId>
        <artifactId>clinerya-records</artifactId>
        <version>0.10.0-beta.1</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>clinerya-records-infra</artifactId>
    <packaging>jar</packaging>

    <name>clinerya-records-infra</name>
    <description>Módulo de infraestructura y adaptadores para expedientes (Spring Boot, JPA, REST)</description>

    <dependencies>
        <!-- Dependencia del módulo de dominio de expedientes -->
        <dependency>
            <groupId>com.jclinical</groupId>
            <artifactId>clinerya-records-domain</artifactId>
        </dependency>

        <!-- Dependencia del módulo de dominio de pacientes (para validar existencia de pacientes) -->
        <dependency>
            <groupId>com.jclinical</groupId>
            <artifactId>clinerya-patients-domain</artifactId>
        </dependency>

        <!-- Dependencia de dominio de clínicas (validar staff) y colaboración (validar accesos externos) -->
        <dependency>
            <groupId>com.jclinical</groupId>
            <artifactId>clinerya-clinics-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jclinical</groupId>
            <artifactId>clinerya-staff-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jclinical</groupId>
            <artifactId>clinerya-collaboration-domain</artifactId>
        </dependency>

        <!-- Dependencia de infra de usuarios para resolver el usuario autenticado (CurrentUserResolver) -->
        <dependency>
            <groupId>com.jclinical</groupId>
            <artifactId>clinerya-users-infra</artifactId>
        </dependency>

        <!-- EmailSenderPort, para el codigo de verificacion del destinatario de un enlace compartido -->
        <dependency>
            <groupId>com.jclinical</groupId>
            <artifactId>clinerya-users-domain</artifactId>
        </dependency>

        <!-- Lectura de estudios (adjuntos) para exponerlos por enlace compartido -->
        <dependency>
            <groupId>com.jclinical</groupId>
            <artifactId>clinerya-attachments</artifactId>
        </dependency>

        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Boot Security -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Spring Data JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Lombok y MapStruct -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
