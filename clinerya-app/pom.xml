<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.jclinical</groupId>
        <artifactId>clinerya-parent</artifactId>
        <version>0.10.0-beta.1</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>clinerya-app</artifactId>
    <packaging>jar</packaging>

    <name>clinerya-app</name>
    <description>Módulo ejecutable y de arranque principal para Clinerya</description>

    <dependencies>
        <!-- Dependencias de infraestructura de módulos -->
        <dependency>
            <groupId>com.jclinical</groupId>
            <artifactId>clinerya-users-infra</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jclinical</groupId>
            <artifactId>clinerya-clinics-infra</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jclinical</groupId>
            <artifactId>clinerya-staff-infra</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jclinical</groupId>
            <artifactId>clinerya-auth-infra</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jclinical</groupId>
            <artifactId>clinerya-patients-infra</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jclinical</groupId>
            <artifactId>clinerya-records-infra</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jclinical</groupId>
            <artifactId>clinerya-attachments</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jclinical</groupId>
            <artifactId>clinerya-inventory-infra</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jclinical</groupId>
            <artifactId>clinerya-treatments-infra</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jclinical</groupId>
            <artifactId>clinerya-agenda-infra</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jclinical</groupId>
            <artifactId>clinerya-integrations-infra</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jclinical</groupId>
            <artifactId>clinerya-cash-infra</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jclinical</groupId>
            <artifactId>clinerya-messaging</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jclinical</groupId>
            <artifactId>clinerya-accounting-infra</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jclinical</groupId>
            <artifactId>clinerya-notifications-infra</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jclinical</groupId>
            <artifactId>clinerya-automation-infra</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jclinical</groupId>
            <artifactId>clinerya-collaboration-infra</artifactId>
        </dependency>

        <!-- Spring Boot Web (necesario para arrancar el servidor embebido) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Flyway Database Migration -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <version>1.4.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
